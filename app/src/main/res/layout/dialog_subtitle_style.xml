<?xml version="1.0" encoding="utf-8"?>
<!-- 字幕样式对话框（字号缩放 / 垂直偏移 / 延迟对齐）— Kazumi 风格 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card_elevated"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="字幕设置"
        android:textColor="@color/colorAccent"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <!-- 字号缩放 -->
    <include layout="@layout/item_danmu_slider"
        android:id="@+id/dm_scale" />

    <!-- 垂直偏移 -->
    <include layout="@layout/item_danmu_slider"
        android:id="@+id/dm_offset" />

    <!-- 延迟对齐 -->
    <include layout="@layout/item_danmu_slider"
        android:id="@+id/dm_delay" />

    <!-- 显示开关 + 外挂字幕 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp">

        <CheckBox
            android:id="@+id/dm_visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="显示字幕"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:focusable="true" />

        <Button
            android:id="@+id/dm_load_ext"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="加载外挂字幕"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:focusable="true" />

    </LinearLayout>

    <!-- 按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="16dp">

        <Button
            android:id="@+id/dm_reset"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_chip"
            android:text="重置"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:focusable="true" />

        <Button
            android:id="@+id/dm_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_chip"
            android:text="取消"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:focusable="true" />

        <Button
            android:id="@+id/dm_ok"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_chip"
            android:text="确定"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
