<?xml version="1.0" encoding="utf-8"?>
<!-- 弹幕设置面板（底部滑出）— 替代 dialog_danmu_settings.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/danmuSettingsPanel"
    android:layout_width="380dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:background="@drawable/bg_side_panel"
    android:clickable="true"
    android:focusable="true"
    android:padding="20dp"
    android:visibility="gone">


    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="弹幕设置"
            android:textColor="@color/colorAccent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDanmuReset"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_chip"
            android:text="重置"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:focusable="true"
            android:nextFocusDown="@+id/dm_sw" />

        <Button
            android:id="@+id/btnDanmuConfirm"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip"
            android:text="✓"
            android:textColor="@color/colorAccent"
            android:textSize="16sp"
            android:focusable="true"
            android:nextFocusUp="@+id/btnDanmuReset" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 弹幕总开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="弹幕总开关"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:drawableStart="@drawable/ic_danmu_on"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/text_secondary"
                    android:focusable="true"
                    android:nextFocusRight="@+id/dm_sw" />

                <Switch
                    android:id="@+id/dm_sw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/tv_dm_main_title"
                    android:nextFocusDown="@+id/tv_dm_type_label" />

            </LinearLayout>

            <!-- 弹幕类型标题 -->
            <TextView
                android:id="@+id/tv_dm_type_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="弹幕类型"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:focusable="true"
                android:nextFocusDown="@+id/dm_show_scroll" />

            <!-- 滚动弹幕 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="滚动弹幕"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:focusable="true"
                    android:nextFocusRight="@+id/dm_show_scroll" />

                <Switch
                    android:id="@+id/dm_show_scroll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/tv_dm_type_label"
                    android:nextFocusDown="@+id/dm_show_top" />

            </LinearLayout>

            <!-- 顶部弹幕 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="顶部弹幕"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:focusable="true"
                    android:nextFocusRight="@+id/dm_show_top" />

                <Switch
                    android:id="@+id/dm_show_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/dm_show_scroll"
                    android:nextFocusDown="@+id/dm_show_bottom" />

            </LinearLayout>

            <!-- 底部弹幕 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="底部弹幕"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:focusable="true"
                    android:nextFocusRight="@+id/dm_show_bottom" />

                <Switch
                    android:id="@+id/dm_show_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/dm_show_top"
                    android:nextFocusDown="@+id/dm_time_scale" />

            </LinearLayout>

            <!-- 时间比例缩放 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="时间比例缩放"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:focusable="true"
                    android:nextFocusRight="@+id/dm_time_scale" />

                <Switch
                    android:id="@+id/dm_time_scale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/dm_show_bottom"
                    android:nextFocusDown="@+id/div1" />

            </LinearLayout>

            <View
                android:id="@+id/div1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <!-- 操作按钮 -->
            <Button
                android:id="@+id/dm_matchBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip"
                android:text="手动匹配弹幕"
                android:textColor="@color/text_white"
                android:focusable="true"
                android:textSize="14sp"
                android:nextFocusDown="@+id/dm_listBtn" />

            <Button
                android:id="@+id/dm_listBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip"
                android:text="弹幕列表"
                android:textColor="@color/text_white"
                android:focusable="true"
                android:textSize="14sp"
                android:nextFocusDown="@+id/div2" />

            <View
                android:id="@+id/div2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <!-- 显示调节 -->
            <include layout="@layout/item_danmu_slider" android:id="@+id/dm_area" />
            <include layout="@layout/item_danmu_slider" android:id="@+id/dm_speed" />
            <include layout="@layout/item_danmu_slider" android:id="@+id/dm_opacity" />
            <include layout="@layout/item_danmu_slider" android:id="@+id/dm_fontsize" />

            <!-- 文字描边 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="文字描边"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:focusable="true"
                android:nextFocusDown="@+id/dm_outline" />

            <Switch
                android:id="@+id/dm_outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@+id/tv_outline_label"
                android:nextFocusDown="@+id/dm_density" />

            <include layout="@layout/item_danmu_slider" android:id="@+id/dm_density" />
            <include layout="@layout/item_danmu_slider" android:id="@+id/dm_maxactive" />
            <include layout="@layout/item_danmu_slider" android:id="@+id/dm_rowspacing" />
            <include layout="@layout/item_danmu_slider" android:id="@+id/dm_offset" />
            <include layout="@layout/item_danmu_slider" android:id="@+id/dm_maxcomments" />

            <!-- 自定义刷新率 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自定义刷新率"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:focusable="true"
                android:nextFocusDown="@+id/dm_custom_fps" />

            <Switch
                android:id="@+id/dm_custom_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@+id/tv_fps_label"
                android:nextFocusDown="@+id/dm_fps" />

            <include layout="@layout/item_danmu_slider" android:id="@+id/dm_fps" />

        </LinearLayout>

    </ScrollView>
</LinearLayout>
