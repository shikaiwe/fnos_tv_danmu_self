<?xml version="1.0" encoding="utf-8"?>
<!-- 首页媒体库文件夹卡片：海报拼贴 + 底部标签 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/home_lib_card_width"
    android:layout_height="@dimen/home_lib_card_height"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_home_folder_card"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.fntv.app.RoundedImageView
            android:id="@+id/ivLibPoster1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="centerCrop" />

        <com.fntv.app.RoundedImageView
            android:id="@+id/ivLibPoster2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="1dp"
            android:layout_weight="1"
            android:scaleType="centerCrop" />

        <com.fntv.app.RoundedImageView
            android:id="@+id/ivLibPoster3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="1dp"
            android:layout_weight="1"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLibName"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />
</LinearLayout>
