<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器主界面 — 极简白色风格（参考图）：顶部箭头+标题、右侧圆环锁、底部细白进度条 + 右下角纯文字选项（含弹幕/超分） -->
<!-- 不使用 fitsSystemWindows：避免状态栏 inset 变成根布局顶部 padding，导致 SurfaceView 下移出现顶部黑边 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Layer 0: 视频画面 -->
    <com.fntv.app.CustomMPVView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 1: 弹幕渲染层 -->
    <com.fntv.app.DanmuView
        android:id="@+id/danmuView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Layer 2: 缓冲提示 -->
    <TextView
        android:id="@+id/tvBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="加载中..."
        android:textColor="@color/text_hint"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Layer 3: 顶部栏 — 左：返回箭头+标题；右：跳过/设置/⋯/直链 -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_gradient_top"
        android:visibility="invisible">

        <!-- 返回按钮: 幽灵图标（无背景箭头），图标由 Java setButtonIcon 设置 -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_marginLeft="4dp"
            android:background="@drawable/bg_icon_ghost"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="10dp"
            android:text=""
            android:nextFocusRight="@+id/btnSettings"
            android:nextFocusDown="@+id/seekBar" />

        <!-- 标题: 白色 18sp 加粗（参考图样式） -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/btnBack"
            android:layout_marginLeft="6dp"
            android:maxWidth="340dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 右侧图标组：右对齐 LinearLayout，避免依赖 GONE 锚点导致塌到左侧 -->
        <LinearLayout
            android:id="@+id/topRightGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 弹幕匹配提示（非焦点文本，与图标同行） -->
            <TextView
                android:id="@+id/tvDanmuMatch"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="8dp"
                android:ellipsize="marquee"
                android:focusable="false"
                android:gravity="center_vertical"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxWidth="200dp"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/accent_light"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- 跳过片头尾入口已整合进设置面板（播放 Tab，见 panel_settings_bottom.xml btnSkipEntry） -->

            <!-- 亮度: 幽灵图标（默认隐藏） -->
            <Button
                android:id="@+id/btnBrightness"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_icon_ghost"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:text=""
                android:textSize="12sp"
                android:nextFocusRight="@+id/btnSettings"
                android:visibility="gone" />

            <!-- 设置: 幽灵图标 → 打开底部设置面板 -->
            <Button
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_icon_ghost"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:text=""
                android:textSize="12sp"
                android:nextFocusLeft="@+id/btnBrightness"
                android:nextFocusRight="@+id/btnInfo"
                android:nextFocusDown="@+id/seekBar" />

            <!-- ⋯ 菜单: 打开信息面板（媒体信息/HDR/字幕设置），图标由 Java 设置为 ic_more -->
            <Button
                android:id="@+id/btnInfo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_icon_ghost"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:text=""
                android:textSize="12sp"
                android:nextFocusLeft="@+id/btnSettings"
                android:nextFocusRight="@+id/btnCloudMode"
                android:nextFocusDown="@+id/seekBar" />

            <!-- 直链状态按钮: chip 样式（直链/STRM 模式时显示） -->
            <Button
                android:id="@+id/btnCloudMode"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_chip"
                android:focusable="true"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="直链"
                android:textColor="@color/accent_light"
                android:textSize="12sp"
                android:nextFocusUp="@+id/btnLock"
                android:nextFocusDown="@+id/btnBack"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Layer 5: 锁定按钮（右侧中部，细白圆环描边，参考图样式） -->
    <ImageView
        android:id="@+id/btnLock"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_vertical|right"
        android:layout_marginRight="12dp"
        android:background="@drawable/bg_round_outline"
        android:focusable="true"
        android:nextFocusUp="@+id/btnCloudMode"
        android:nextFocusDown="@+id/btnQuality"
        android:padding="14dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_lock_off"
        android:visibility="invisible" />

    <!-- Layer 4: 底部控制栏 (渐变背景) -->
    <LinearLayout
        android:id="@+id/controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_bottom"
        android:visibility="invisible">

        <!-- 进度条区域（参考图：时间在进度条上方左侧小字） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="2dp">

            <!-- 时间：当前时间白色 / 总时长灰色（Java SpannableString 分色） -->
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="2dp"
                android:text="00:00 / 00:00"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="0"
                android:focusable="true"
                android:nextFocusDown="@+id/btnPlayPause"
                android:defaultFocusHighlightEnabled="false"
                android:background="@null"
                android:splitTrack="false"
                android:progressDrawable="@drawable/seeker_progress_minimal"
                android:thumb="@drawable/seeker_thumb_minimal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- 主控制按钮行：左=播放/上下集（幽灵图标），右=纯文字选项（含弹幕/超分） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp">

            <!-- 左区：上一集 / 播放暂停 / 下一集（幽灵图标，图标由 Java 设置） -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRewind"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_ghost"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="10dp"
                    android:text=""
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnPlayPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_ghost"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="12dp"
                    android:text=""
                    android:textSize="13sp"
                    android:nextFocusUp="@+id/seekBar" />

                <Button
                    android:id="@+id/btnForward"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/bg_icon_ghost"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="10dp"
                    android:text=""
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 右区：纯文字选项行（参考图样式 + 弹幕/超分） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEpisodeList"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_text_option"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="选集"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:visibility="gone"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnForward"
                    android:nextFocusRight="@+id/btnDanmu" />

                <Button
                    android:id="@+id/btnDanmu"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_text_option"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="弹幕"
                    android:textColor="@color/colorAccent"
                    android:textSize="15sp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnEpisodeList"
                    android:nextFocusRight="@+id/btnSpeed" />

                <Button
                    android:id="@+id/btnSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_text_option"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="1X"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnDanmu"
                    android:nextFocusRight="@+id/btnRatio" />

                <Button
                    android:id="@+id/btnRatio"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_text_option"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="适应"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnSpeed"
                    android:nextFocusRight="@+id/btnAudioTrack" />

                <Button
                    android:id="@+id/btnAudioTrack"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_text_option"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="音频"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnRatio"
                    android:nextFocusRight="@+id/btnSubtitleTrack" />

                <Button
                    android:id="@+id/btnSubtitleTrack"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_text_option"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="字幕"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnAudioTrack"
                    android:nextFocusRight="@+id/btnAnime4K" />

                <Button
                    android:id="@+id/btnAnime4K"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_text_option"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="超分"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnSubtitleTrack"
                    android:nextFocusRight="@+id/btnQuality" />

                <Button
                    android:id="@+id/btnQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_text_option"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="原画"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnAnime4K" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Layer 6: 弹幕状态提示（覆盖在视频上方） -->
    <TextView
        android:id="@+id/tvDanmuStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_danmu_status"
        android:ellipsize="end"
        android:maxLines="3"
        android:maxWidth="420dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_white"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Layer 6: 长按倍速提示 -->
    <TextView
        android:id="@+id/tvSpeedHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_danmu_status_hint"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="倍速播放中"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Layer 7: 信息面板已改为右侧抽屉弹窗（SideDrawerHelper，见 PlayerActivity.showInfoDrawer） -->

    <!-- Layer 8: 手势指示浮层（三区域圆形进度环 + 双击/倍速反馈） -->
    <include layout="@layout/view_gesture_overlay" android:id="@+id/gestureOverlay" />

    <!-- Layer 8.1: 锁定遮罩层（四角角标，锁定后显示） -->
    <include layout="@layout/view_lock_overlay" android:id="@+id/lockOverlay" />

    <!-- 设置面板外部点击遮罩：拦截播放器手势并关闭右侧面板 -->
    <View
        android:id="@+id/settingsBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Layer 8.5: 底部设置面板（双层 Tab）；弹幕/字幕/跳过设置已迁移为 SideDrawerHelper 右侧抽屉 -->
    <include layout="@layout/panel_settings_bottom" />

    <!-- Layer 9: 视频加载/错误状态浮层 -->
    <include layout="@layout/view_loading_overlay" android:id="@+id/loadingOverlay" />

</FrameLayout>
