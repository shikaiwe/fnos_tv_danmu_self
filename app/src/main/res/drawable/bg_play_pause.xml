<?xml version="1.0" encoding="utf-8"?>
<!-- 主播放按钮背景：圆形 accent 色，带 focus/pressed 状态 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 聚焦状态 -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#FFFB6F92" />
            <stroke android:width="2dp" android:color="#FFF8BBD0" />
        </shape>
    </item>
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FFE94560" />
        </shape>
    </item>
    <!-- 默认状态 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFB6F92" />
        </shape>
    </item>
</selector>
