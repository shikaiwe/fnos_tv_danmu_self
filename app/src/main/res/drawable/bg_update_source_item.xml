<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF39242B" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/accent_light" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_button_focused" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/border_focused" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF332127" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/colorAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_input" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
